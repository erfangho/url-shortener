vars:pre-request {
  baseUrl: http://localhost:8080
}

headers {
  accept: application/json
  content-type: application/json
}

docs {
  # URL Shortener API
  
  A RESTful API for shortening URLs with JWT authentication.
  
  ## Features
  - Create short URLs
  - Redirect to original URLs
  - Track click counts
  - JWT authentication
  - Pagination support
}
